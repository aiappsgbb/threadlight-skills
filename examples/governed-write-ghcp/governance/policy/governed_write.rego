package threadlight.governed_write

import rego.v1

# Four business rules for ONE governed write (returns_apply_decision).
# Case facts come from the signed case snapshot (cases.rego, generated by
# scripts/build_policy.py from the seeded cases), never from model arguments.
# The business API independently re-checks revision, status and the same
# invariants before its transactional write; this policy is not the only check.

import data.threadlight.governed_write_cases.cases

default pre_tool_call := {"decision": "deny", "reason": "outside_governed_write_scope"}

args := input.policy_target.value

case_facts := cases[args.case_id]

high_value if case_facts.amount > 500

high_value if case_facts.high_risk == true

# Rule 1: only cases in the signed snapshot can be decided at all.
pre_tool_call := {"decision": "deny", "reason": "case_not_in_signed_snapshot"} if {
	input.snapshot.tool_call.name == "returns_apply_decision"
	not case_facts
}

# Rule 2: a refund can be approved only for an eligible case, denied only for an ineligible one.
else := {"decision": "deny", "reason": "refund_eligibility_mismatch"} if {
	input.snapshot.tool_call.name == "returns_apply_decision"
	args.decision == "approve_refund"
	not case_facts.eligible
} else := {"decision": "deny", "reason": "refund_eligibility_mismatch"} if {
	input.snapshot.tool_call.name == "returns_apply_decision"
	args.decision == "deny_refund"
	case_facts.eligible
}

# Rule 3: a high-value or high-risk case can only be handed to a supervisor,
# and that handoff needs a human approver (ACS escalate -> deferred review).
else := {"decision": "escalate", "reason": "supervisor_handoff_requires_approval"} if {
	input.snapshot.tool_call.name == "returns_apply_decision"
	high_value
	args.decision == "escalate_to_supervisor"
} else := {"decision": "deny", "reason": "high_value_requires_supervisor"} if {
	input.snapshot.tool_call.name == "returns_apply_decision"
	high_value
}

# Rule 4: ordinary decisions on ordinary cases are recorded autonomously.
else := {"decision": "allow", "reason": "ordinary_return_decision"} if {
	input.snapshot.tool_call.name == "returns_apply_decision"
	args.decision in {"approve_refund", "deny_refund", "request_more_info", "escalate_to_supervisor"}
}
