{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "threadlight-evals-manifest/v1",
  "title": "threadlight evals manifest",
  "description": "Emitted by threadlight-evals (scripts/evals_check.py). Consumed by threadlight-production-ready pillar 6 (continuous-evals).",
  "type": "object",
  "required": ["schema", "tool_version", "captured_at", "verdict", "capabilities"],
  "properties": {
    "schema": {"const": "threadlight-evals-manifest/v1"},
    "tool_version": {"type": "string"},
    "captured_at": {"type": "string", "format": "date-time"},
    "freshness_window_days": {"type": "integer", "minimum": 0},
    "verdict": {"enum": ["comprehensive", "partial", "offline-only", "none"]},
    "must_fix": {"type": "array", "items": {"type": "string"}},
    "should_fix": {"type": "array", "items": {"type": "string"}},
    "not_verified": {"type": "array", "items": {"type": "string"}},
    "agentops": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "agents"],
      "properties": {
        "source": {"const": "specs/agentops-manifest.json"},
        "source_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent_key", "root", "source", "capabilities", "execution_pass_rate"],
            "properties": {
              "agent_key": {"type": "string"},
              "service": {"type": ["string", "null"]},
              "root": {"type": "string"},
              "source": {"const": "specs/agentops-manifest.json"},
              "source_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "evidence_refs": {"type": "array", "items": {"type": "string"}},
              "artifacts": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
              "receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "domain_status": {"enum": ["verified", "not-verified", "stale", "invalid", "not-applicable"]},
              "represented_blockers": {"type": "array", "items": {"const": "AOPS-EVAL-QUALITY"}},
              "execution_pass_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "aggregate_metrics": {"type": "object", "additionalProperties": {"type": "number"}},
              "thresholds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["metric", "passed"],
                  "properties": {"metric": {"type": "string"}, "passed": {"type": "boolean"}}
                }
              },
              "comparison": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": {
                  "status": {"type": ["string", "null"]},
                  "regressions": {"type": ["integer", "null"], "minimum": 0}
                }
              },
              "finished_at": {"type": ["string", "null"], "format": "date-time"},
              "capabilities": {
                "type": "object",
                "additionalProperties": {"enum": ["pass", "must-fix", "should-fix", "not-verified"]}
              }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eval_scenarios_present",
        "eval_datasets_present",
        "dataset_shape_ok",
        "thresholds_declared",
        "schedule_present",
        "run_history_present",
        "online_eval_wired",
        "latest_eval_run_fresh",
        "alert_wired",
        "latest_pass_rate_ok",
        "ab_comparison_present"
      ],
      "properties": {
        "eval_scenarios_present": {"$ref": "#/definitions/capability"},
        "eval_datasets_present": {"$ref": "#/definitions/capability"},
        "dataset_shape_ok": {"$ref": "#/definitions/capability"},
        "thresholds_declared": {"$ref": "#/definitions/capability"},
        "schedule_present": {"$ref": "#/definitions/capability"},
        "run_history_present": {"$ref": "#/definitions/capability"},
        "online_eval_wired": {"$ref": "#/definitions/capability"},
        "latest_eval_run_fresh": {"$ref": "#/definitions/capability"},
        "alert_wired": {"$ref": "#/definitions/capability"},
        "latest_pass_rate_ok": {"$ref": "#/definitions/capability"},
        "ab_comparison_present": {"$ref": "#/definitions/capability"}
      }
    }
  },
  "definitions": {
    "capability": {
      "type": "object",
      "required": ["check_id", "status"],
      "properties": {
        "check_id": {"type": "string"},
        "status": {"enum": ["pass", "must-fix", "should-fix", "not-verified", "not-applicable"]},
        "evidence": {"type": ["string", "null"]},
        "hint": {"type": ["string", "null"]}
      }
    }
  }
}
