{
  "schema": "threadlight.runtime-policy/v1",
  "version": 2,
  "contract_version": "2.2.0",
  "last_reviewed": "2026-11-05",
  "authority": {
    "repository": "aiappsgbb/threadlight-skills",
    "path": "skills/threadlight-design/references/runtime-policy.json",
    "cross_repository_consumers": false
  },
  "agent_hosting": {
    "platform": "microsoft-foundry",
    "default": "hosted",
    "allowed_agent_types": [
      "hosted",
      "prompt",
      "voice",
      "harness"
    ],
    "prompt_requires_all_trivial_criteria": [
      "exactly-one-model",
      "no-custom-code-tools",
      "no-multi-step-orchestration-or-hitl",
      "no-state-beyond-foundry-thread",
      "no-skills-provider",
      "no-custom-middleware-or-telemetry"
    ],
    "prompt_requires_field": "trivial_justification",
    "prompt_requires_explicit_opt_in": true,
    "prompt_opt_in_sources": [
      "spec-agent-type-prompt",
      "explicit-user-request"
    ],
    "prompt_opt_in_required_fields": [
      "trivial_justification",
      "prompt_opt_in_source",
      "prompt_opt_in_evidence"
    ],
    "prompt_opt_in_source_allowed": [
      "user"
    ],
    "agent_authored_spec_counts_as_opt_in": false,
    "agent_may_select_prompt_on_own_initiative": false,
    "voice_requires_explicit_opt_in": true,
    "voice_opt_in_required_fields": [
      "voice_opt_in_source",
      "voice_opt_in_evidence",
      "preview_acknowledged"
    ],
    "voice_opt_in_source_allowed": [
      "user"
    ],
    "agent_may_select_voice_on_own_initiative": false,
    "voice_build_route": "azure@azure-skills/microsoft-foundry/foundry-agent/create/create-voice.md",
    "voice_frontend_values": [
      "none",
      "hosted-voice"
    ],
    "voice_frontend_default": "none",
    "voice_frontend_requires_agent_type": "hosted",
    "voice_frontend_runtimes": [
      "ghcp"
    ],
    "voice_frontend_opt_in_required_fields": [
      "voice_opt_in_source",
      "voice_opt_in_evidence",
      "preview_acknowledged"
    ],
    "agent_may_select_voice_frontend_on_own_initiative": false,
    "voice_frontend_build_route": "threadlight-deploy generate_only: managed kind: voice wrapper + GHCP Voice Live Bridge 1.0 on /invocations_ws",
    "harness_requires_explicit_opt_in": true,
    "harness_type": "microsoft_copilot_preview",
    "harness_opt_in_required_fields": [
      "harness_opt_in_source",
      "harness_opt_in_evidence",
      "preview_acknowledged",
      "harness_fit"
    ],
    "harness_opt_in_source_allowed": [
      "user"
    ],
    "agent_may_select_harness_on_own_initiative": false,
    "harness_unknown_fit_answer_disqualifies": true,
    "harness_disqualifiers": [
      {
        "id": "citadel-model-path-required",
        "fit_field": "citadel_model_path_required",
        "disqualifies_unless": false,
        "reason": "The harness does not support bring-your-own-model through AI Gateway, so a mandatory Citadel/APIM model path cannot be honoured."
      },
      {
        "id": "acs-in-process-pep-required",
        "fit_field": "acs_in_process_pep_required",
        "disqualifies_unless": false,
        "reason": "The harness has no Agent Hooks surface, so an in-process ACS policy enforcement point cannot run inside the agent loop."
      },
      {
        "id": "foundry-memory-required",
        "fit_field": "foundry_memory_required",
        "disqualifies_unless": false,
        "reason": "Foundry Memory stores and memory tools are not available with the harness."
      },
      {
        "id": "voice-frontend-required",
        "fit_field": "voice_frontend_required",
        "disqualifies_unless": false,
        "also_when_spec": {
          "voice_frontend": "hosted-voice"
        },
        "reason": "The harness takes text, image and file input over HTTP only; the Hosted Voice front-end needs the GHCP hosted agent."
      },
      {
        "id": "region-not-supported",
        "fit_field": "region",
        "allowed_values_ref": "harness_supported_regions",
        "reason": "The harness runs only in its documented preview regions."
      },
      {
        "id": "consequential-write-without-function-or-governed-mcp",
        "fit_field": "consequential_write_seam",
        "allowed_values": [
          "none",
          "function-tool",
          "governed-mcp"
        ],
        "reason": "The service manages harness tool approval; consequential writes must go through a client function tool or a governed MCP tool with require_approval: always."
      }
    ],
    "harness_fit_questions": [
      {
        "field": "read_mostly",
        "question": "Is the work read-mostly (lookups, triage, drafting) rather than write-heavy?",
        "advisory_when": false,
        "advisory": "not read-mostly: every consequential write needs a client function tool or governed MCP seam, so the harness saves less than for read-mostly work"
      },
      {
        "field": "citadel_model_path_required",
        "question": "Is the Citadel (AI Gateway) model path mandatory?",
        "disqualifier": "citadel-model-path-required"
      },
      {
        "field": "acs_in_process_pep_required",
        "question": "Must ACS enforce policy in process (Agent Hooks pre_tool_call)?",
        "disqualifier": "acs-in-process-pep-required"
      },
      {
        "field": "consequential_write_seam",
        "question": "Are consequential writes needed, and through which seam (none, function-tool, governed-mcp)?",
        "disqualifier": "consequential-write-without-function-or-governed-mcp"
      },
      {
        "field": "region",
        "question": "Is the target region a documented harness region?",
        "disqualifier": "region-not-supported"
      },
      {
        "field": "foundry_memory_required",
        "question": "Is Foundry Memory needed?",
        "disqualifier": "foundry-memory-required"
      },
      {
        "field": "voice_frontend_required",
        "question": "Is a voice front-end needed?",
        "disqualifier": "voice-frontend-required"
      }
    ],
    "harness_supported_regions": [
      "australiaeast",
      "brazilsouth",
      "canadacentral",
      "canadaeast",
      "centralus",
      "eastus",
      "francecentral",
      "germanywestcentral",
      "italynorth",
      "japaneast",
      "koreacentral",
      "northcentralus",
      "norwayeast",
      "polandcentral",
      "southeastasia",
      "southindia",
      "spaincentral",
      "swedencentral",
      "uksouth",
      "westeurope",
      "westus",
      "westus3"
    ],
    "harness_regions_source": "https://learn.microsoft.com/azure/foundry/agents/concepts/limits-quotas-regions#microsoft-copilot-harness-preview",
    "harness_build_route": "Foundry prompt agent with harness.type microsoft_copilot_preview (https://learn.microsoft.com/azure/foundry/agents/how-to/use-tools-skills-copilot-harness)",
    "refusal_route": "hosted",
    "prohibited": [
      "voice-agents-without-explicit-opt-in",
      "app-code-voice-live-calls",
      "harness-without-explicit-opt-in",
      "preview-only-capabilities",
      "app-code-agent-loop"
    ],
    "auxiliary_compute_may_host": [
      "ui",
      "thin-api-proxy",
      "mcp-tool-servers",
      "jobs"
    ],
    "overrides_user_instructions": true,
    "canonical": "skills/_shared/foundry-only-agents.md"
  },
  "region_policy": {
    "default": "eastus2",
    "eu_residency": [
      "swedencentral"
    ],
    "selection_rule": "Use an EU region only when the complete required resource set is available there."
  },
  "selectors": {
    "frameworks": [
      "microsoft-agent-framework",
      "microsoft-copilot-sdk"
    ],
    "runtime_shapes": [
      "agent",
      "workflow"
    ],
    "protocols": [
      "invocations",
      "responses"
    ]
  },
  "framework_aliases": {
    "github-copilot-sdk": "microsoft-copilot-sdk"
  },
  "governance_compatibility": {
    "microsoft-agent-framework": [
      "none",
      "local-agent-hooks",
      "governed-tool-gateway"
    ],
    "microsoft-copilot-sdk": [
      "none",
      "governed-tool-gateway"
    ]
  },
  "default": {
    "framework": "microsoft-copilot-sdk",
    "runtime_shape": "agent",
    "protocol": "invocations",
    "policy_route": "default-agent"
  },
  "compatible_combinations": [
    {
      "framework": "microsoft-copilot-sdk",
      "runtime_shape": "agent",
      "protocol": "invocations"
    },
    {
      "framework": "microsoft-agent-framework",
      "runtime_shape": "agent",
      "protocol": "responses"
    },
    {
      "framework": "microsoft-agent-framework",
      "runtime_shape": "workflow",
      "protocol": "responses"
    }
  ],
  "routes": [
    {
      "id": "explicit-supported-choice",
      "priority": 1,
      "decision_date": "2026-08-17",
      "permanent": true,
      "selection": "operator",
      "allowed_combinations_ref": "compatible_combinations",
      "when": "operator explicitly chooses a framework/runtime_shape/protocol tuple listed in compatible_combinations",
      "requires_resolved_signals": true,
      "blocked_when": [
        "workflow_model=workflow",
        "requires_toolbox",
        "requires_custom_python_tools",
        "requires_file_generation",
        "latency_sensitive_data_queries"
      ],
      "rationale": "Honor a compatible explicit operator override before house routing, unless a blocked_when capability signal is active — the capability route that owns that signal takes the case instead, regardless of compatible_combinations membership. requires_resolved_signals is a separate gate: false-vs-unknown is never ambiguous here, so this route also refuses to fire while capability_signals.unresolved_signals is non-empty — an unresolved signal must be resolved (or the case escalated) before an operator's explicit choice can be honored, since it could still turn out to be the one a blocked_when route owns."
    },
    {
      "id": "deterministic-workflow",
      "priority": 2,
      "decision_date": "2026-08-17",
      "permanent": true,
      "when": "workflow_model=workflow",
      "framework": "microsoft-agent-framework",
      "runtime_shape": "workflow",
      "protocol": "responses",
      "rationale": "Deterministic multi-phase flows route to MAF + Responses; deploy generates the MAF Agent container (workflow-graph generation is not shipped)."
    },
    {
      "id": "maf-agent-capabilities",
      "priority": 3,
      "decision_date": "2026-08-17",
      "permanent": true,
      "when": "requires_toolbox || requires_custom_python_tools || requires_file_generation || latency_sensitive_data_queries",
      "framework": "microsoft-agent-framework",
      "runtime_shape": "agent",
      "protocol": "responses",
      "rationale": "Toolbox, custom tools, file generation, and fast data queries fit MAF agent best today."
    },
    {
      "id": "default-agent",
      "priority": 4,
      "decision_date": "2026-08-05",
      "expiry_condition": "Responses works end to end for the generated hosted runtime and every documented channel.",
      "when": "no higher-priority route matches",
      "framework": "microsoft-copilot-sdk",
      "runtime_shape": "agent",
      "protocol": "invocations",
      "rationale": "Keep the proven GHCP Invocations path until Responses works end to end."
    }
  ]
}
