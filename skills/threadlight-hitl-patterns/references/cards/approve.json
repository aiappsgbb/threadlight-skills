{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {"type": "TextBlock", "text": "${title}", "size": "large", "weight": "bolder", "wrap": true},
    {"type": "TextBlock", "text": "${summary}", "wrap": true},
    {"type": "FactSet", "facts": [
      {"title": "Case", "value": "${caseId}"},
      {"title": "Rules", "value": "${linkedRules}"}
    ]},
    {"type": "TextBlock", "text": "Your decision will be checked against the current review.", "isSubtle": true, "wrap": true}
  ],
  "actions": [
    {"type": "Action.Submit", "title": "Approve", "style": "positive", "data": {"gate": "approve", "decision": "approved", "case_id": "${caseId}", "review_id": "${reviewId}"}},
    {"type": "Action.Submit", "title": "Decline", "style": "destructive", "data": {"gate": "approve", "decision": "declined", "case_id": "${caseId}", "review_id": "${reviewId}"}}
  ]
}
