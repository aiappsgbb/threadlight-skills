          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "residual_risk_ref": {
          "type": ["string", "null"]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "display_name",
        "aliases",
        "owner",
        "declaration_refs",
        "implementation_refs",
        "input_schema_sha256",
        "output_schema_sha256",
        "source",
        "consequence",
        "secondary_consequences",
        "reversible",
        "compensation_ref",
        "execution_modes",
        "provider_hosted",
        "approval_required",
        "policy_ids",
        "known_runtime_paths",
        "inventory_status"
      ],
      "properties": {
        "action_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": ["string", "null"]
        },
        "declaration_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementation_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_schema_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "output_schema_sha256": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "source": {
          "type": "string"
        },
        "consequence": {
          "anyOf": [{ "$ref": "#/$defs/consequence" }, { "type": "null" }]
        },
        "secondary_consequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consequence"
          }
        },
        "reversible": {
          "type": ["boolean", "null"]
        },
        "compensation_ref": {
          "type": ["string", "null"]
        },
        "execution_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionMode"
          }
        },
        "provider_hosted": {
          "type": "boolean"
        },
        "approval_required": {
          "type": ["boolean", "null"]
        },
        "policy_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_runtime_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
