    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_id",
        "action_id",
        "mode",
        "nodes",
        "pre_action_seam",
        "equivalent_control_ref",
        "covered",
        "discovered",
        "executed",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "path_id": {
          "type": "string"
        },
        "action_id": {
          "type": "string"
        },
