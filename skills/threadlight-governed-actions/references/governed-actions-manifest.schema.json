        "reason_code",
        "summary",
        "details",
        "affected_actions",
        "affected_paths",
        "evidence_refs",
        "remediation_ids",
        "residual_risk_ref"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/findingId"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "plane": {
          "$ref": "#/$defs/plane"
        },
        "reason_code": {
          "type": "string"
        },
        "summary": {
          "type": "string"
