          "$ref": "#/$defs/status"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "pass"}, "probe_id": {"const": "approval-anti-replay"},
                               "reason_code": {"not": {"const": "native-local-executed"}}}},
          "then": {"properties": {"evidence_refs": {"minItems": 2, "contains": {"pattern": "^approval-ledger-records-[0-9a-f]{64}$"}}}}
        },
        {
          "if": {"properties": {"status": {"const": "pass"}, "probe_id": {"const": "output-mediation"}}},
          "then": {"properties": {"evidence_refs": {"contains": {"pattern": "^output-ledger-records-[0-9a-f]{64}$"}}}}
        },
        {
          "if": {"properties": {"status": {"const": "pass"}, "probe_id": {"const": "payload-free-audit"},
                               "reason_code": {"not": {"const": "native-local-executed"}}}},
          "then": {"properties": {"evidence_refs": {"minItems": 2, "contains": {"pattern": "^audit-ledger-records-[0-9a-f]{64}$"}}}}
        },
        {
          "if": {"properties": {"reason_code": {"const": "native-local-executed"}}},
          "then": {"properties": {
            "probe_id": {"enum": ["approval-anti-replay", "payload-free-audit", "native-tool-result-schema", "native-enforcement"]},
            "action_id": {"const": "returns_apply_decision"},
            "path_id": {"type": "null"}, "mode": {"type": "null"}, "status": {"const": "pass"},
            "evidence_refs": {"minItems": 2, "maxItems": 2, "uniqueItems": true, "allOf": [
              {"contains": {"pattern": "^native-(approval|durable-audit|tool-result-schema|enforcement)-[0-9a-f]{64}$"}},
              {"contains": {"pattern": "^(approval-anti-replay|payload-free-audit|native-tool-result-schema|native-enforcement)-installation$"}}
            ]}
          }}
        }
      ],
      "required": [
        "probe_id",
        "action_id",
        "path_id",
        "mode",
        "status",
        "reason_code",
        "expected_sha256",
        "observed_sha256",
        "evidence_refs"
      ],
      "properties": {
        "probe_id": {
          "type": "string"
        },
        "action_id": {
          "type": ["string", "null"]
        },
        "path_id": {
          "type": ["string", "null"]
        },
        "mode": {
          "anyOf": [{ "$ref": "#/$defs/executionMode" }, { "type": "null" }]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "reason_code": {
          "type": "string"
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observed_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
