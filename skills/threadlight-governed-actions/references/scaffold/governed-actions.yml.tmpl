name: Governed Actions Contract Checks

# Scaffolded workflow (Task 11 bounded MAF scaffold). Runs only local,
# fixture-based checks against this pull request's own checkout: the
# assessor's own CTK vectors, a local application probe, and the
# scaffolded governance contract test. This workflow makes no live
# network call beyond fetching the checkout and installing pinned
# dependencies, deploys nothing, and is granted no deploy permission --
# `permissions` below is read-only at both the workflow and job level,
# and no step in this file ever requests more.

on:
  pull_request:

permissions:
  contents: read

# GOVERNED_ACTIONS_SCAFFOLD_UNMODIFIED marks this workflow as still an
# unreviewed Task 11 scaffold: the GHCP change-plane assessor recognizes
# this exact key/value pair and refuses to count this file's CTK/
# application-probe commands as CI evidence until it is wired up for
# real. Remove this `env:` block (or this one key) once you have
# reviewed and committed to what this workflow actually runs.
env:
  GOVERNED_ACTIONS_SCAFFOLD_UNMODIFIED: "true"

jobs:
  governed-actions-contract:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@0ad4c47a9e566829e19b6099ee3458ac923f5d3c

      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: "3.12"

      - name: Install test dependencies
        run: |
          python -m pip install --upgrade pip
          python -m pip install pytest pyyaml

      - name: Run CTK and application probes
        run: |
          python -m ctk run-vectors
          python -m probes run-application-probe

      - name: Run scaffolded governance contract test
        run: python -m pytest tests/governance/test_governed_actions_contract.py -q
