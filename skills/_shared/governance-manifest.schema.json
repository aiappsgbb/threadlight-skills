{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "threadlight-governance-manifest/v1",
  "type": "object",
  "required": [
    "schema",
    "agent",
    "policy_bundle",
    "enforcement",
    "coverage",
    "bindings",
    "live_probes",
    "gaps"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "enforcement": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "evaluate_only"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "enforcement"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "tools_enforced": {
                "const": 0
              }
            }
          },
          "bindings": {
            "not": {
              "contains": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "status": {
                        "const": "enforced"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "const": "enforce"
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "threadlight-governance-manifest/v1"
    },
    "agent": {
      "type": "object",
      "required": [
        "runtime",
        "version",
        "image_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/definitions/version"
        },
        "image_digest": {
          "$ref": "#/definitions/sha256Digest"
        }
      }
    },
    "policy_bundle": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest",
        "signature_verified",
        "expires_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "version": {
          "$ref": "#/definitions/version"
        },
        "digest": {
          "$ref": "#/definitions/sha256Digest"
        },
        "signature_verified": {
          "type": "boolean"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "enforcement": {
      "type": "object",
      "required": [
        "adapter",
        "mode",
        "agent_hooks_distribution",
        "agent_hooks_artifact_sha256",
        "acs_distribution",
        "acs_artifact_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "enforce",
            "evaluate_only"
          ]
        },
        "agent_hooks_distribution": {
          "$ref": "#/definitions/version"
        },
        "agent_hooks_artifact_sha256": {
          "$ref": "#/definitions/sha256Digest"
        },
        "acs_distribution": {
          "$ref": "#/definitions/version"
        },
        "acs_artifact_sha256": {
          "$ref": "#/definitions/sha256Digest"
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "tools_total",
        "tools_bound",
        "tools_enforced",
        "tools_observed",
        "tools_unbound",
        "tools_unverified",
        "tools_unsupported",
        "tools_bypassable"
      ],
      "additionalProperties": false,
      "properties": {
        "tools_total": {
          "type": "integer",
          "minimum": 0
        },
        "tools_bound": {
          "type": "integer",
          "minimum": 0
        },
        "tools_enforced": {
          "type": "integer",
          "minimum": 0
        },
        "tools_observed": {
          "type": "integer",
          "minimum": 0
        },
        "tools_unbound": {
          "type": "integer",
          "minimum": 0
        },
        "tools_unverified": {
          "type": "integer",
          "minimum": 0
        },
        "tools_unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "tools_bypassable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/binding"
      }
    },
    "live_probes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/liveProbe"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/gap"
      }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+)*(?:[A-Za-z][0-9A-Za-z.-]*)?$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^EV-[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "interventionPoint": {
      "enum": [
        "input",
        "pre_model_call",
        "post_model_call",
        "pre_tool_call",
        "post_tool_call",
        "output",
        "startup",
        "shutdown"
      ]
    },
    "binding": {
      "type": "object",
      "required": [
        "binding_id",
        "tool_id",
        "enforcement_path",
        "intervention_points",
        "mode",
        "safe_principles",
        "status",
        "policy_digest",
        "probe_ids",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "$ref": "#/definitions/identifier"
        },
        "tool_id": {
          "$ref": "#/definitions/identifier"
        },
        "enforcement_path": {
          "enum": [
            "none",
            "local-agent-hooks",
            "governed-tool-gateway"
          ]
        },
        "intervention_points": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/interventionPoint"
          }
        },
        "mode": {
          "enum": [
            "enforce",
            "evaluate_only"
          ]
        },
        "safe_principles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "enforced",
            "observed",
            "unbound",
            "unsupported",
            "unverified",
            "bypassable"
          ]
        },
        "policy_digest": {
          "$ref": "#/definitions/sha256Digest"
        },
        "probe_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/identifier"
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/evidenceRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "enforced",
                  "observed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "probe_ids": {
                "minItems": 1
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "liveProbe": {
      "type": "object",
      "required": [
        "probe_id",
        "binding_id",
        "environment",
        "agent_version",
        "decision",
        "downstream_effect_delta",
        "decision_receipt_ref",
        "service_oracle_ref",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "probe_id": {
          "$ref": "#/definitions/identifier"
        },
        "binding_id": {
          "$ref": "#/definitions/identifier"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "agent_version": {
          "$ref": "#/definitions/version"
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "downstream_effect_delta": {
          "type": "integer",
          "minimum": 0
        },
        "decision_receipt_ref": {
          "$ref": "#/definitions/evidenceRef"
        },
        "service_oracle_ref": {
          "$ref": "#/definitions/evidenceRef"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "gapBinding": {
      "type": "object",
      "required": [
        "binding_id",
        "status",
        "reason_code",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "$ref": "#/definitions/identifier"
        },
        "status": {
          "enum": [
            "observed",
            "unbound",
            "unsupported",
            "unverified",
            "bypassable"
          ]
        },
        "reason_code": {
          "$ref": "#/definitions/identifier"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/evidenceRef"
          }
        }
      }
    },
    "gapTool": {
      "type": "object",
      "required": [
        "tool_id",
        "status",
        "reason_code",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "tool_id": {
          "$ref": "#/definitions/identifier"
        },
        "status": {
          "enum": [
            "observed",
            "unbound",
            "unsupported",
            "unverified",
            "bypassable"
          ]
        },
        "reason_code": {
          "$ref": "#/definitions/identifier"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/evidenceRef"
          }
        }
      }
    },
    "gap": {
      "oneOf": [
        {
          "$ref": "#/definitions/gapBinding"
        },
        {
          "$ref": "#/definitions/gapTool"
        }
      ]
    }
  }
}
