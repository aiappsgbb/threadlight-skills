{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "principalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "mcpImage": {
      "value": "${SERVICE_MCP_IMAGE_NAME=mcr.microsoft.com/k8se/quickstart:latest}"
    },
    "mcpMinReplicas": {
      "value": "${MCP_MIN_REPLICAS=0}"
    },
    "returnsCosmosUrl": {
      "value": "${RETURNS_COSMOS_URL=}"
    },
    "modelCapacity": {
      "value": "${AZURE_AI_MODEL_CAPACITY=300}"
    },
    "modelGateway": {
      "value": "${THREADLIGHT_MODEL_GATEWAY=none}"
    },
    "acrBuildAllowedPrefixes": {
      "value": "${THREADLIGHT_ACR_BUILD_PREFIXES=}"
    },
    "jumpboxSshPublicKey": {
      "value": "${JUMPBOX_SSH_PUBLIC_KEY=}"
    },
    "bastionDeveloper": {
      "value": "${THREADLIGHT_BASTION_DEVELOPER=true}"
    },
    "modelGatewayUrl": {
      "value": "${THREADLIGHT_MODEL_GATEWAY_URL=}"
    },
    "existingVnetId": {
      "value": "${THREADLIGHT_EXISTING_VNET_ID=}"
    },
    "dnsZonesResourceGroup": {
      "value": "${THREADLIGHT_DNS_ZONES_RG=}"
    },
    "dnsZoneLinkVnetId": {
      "value": "${THREADLIGHT_DNS_LINK_VNET_ID=}"
    },
    "aiSearchLocation": {
      "value": "${THREADLIGHT_AI_SEARCH_LOCATION=}"
    },
    "tags": {
      "value": {
        "owner": "${THREADLIGHT_OWNER}",
        "purpose": "${THREADLIGHT_PURPOSE}",
        "disposable": "${THREADLIGHT_DISPOSABLE}"
      }
    }
  }
}
