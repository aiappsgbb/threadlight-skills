"""Mock MCP server for {{PROJECT_NAME}} (generated by threadlight-deploy generate-only).

Tools come from SPEC section 6 and answer from the synthetic records in
specs/sample-data. Runs over stdio locally and streamable-http (port 8080,
path /mcp) on Azure Container Apps. This server is a TOOL called by the
Foundry hosted agent; it never hosts the agent's reasoning or tool loop.
"""
import json
import os
import pathlib
import sys
from typing import Any, Optional

from mcp.server.fastmcp import FastMCP

_HERE = pathlib.Path(__file__).resolve().parent
# In the container this file lives at /app/server.py, so never derive the data
# directory from a fixed parent depth. Use the env var, else the local repo
# layout, else the container layout.
_DATA = pathlib.Path(
    os.getenv("SAMPLE_DATA_DIR")
    or next(
        (str(p) for p in (_HERE.parent.parent / "specs" / "sample-data", _HERE / "sample-data") if p.is_dir()),
        str(_HERE / "sample-data"),
    )
)

mcp = FastMCP("{{PROJECT_NAME}}", host="0.0.0.0", port=int(os.getenv("PORT") or "8080"))

# Tool table derived from SPEC section 6: kind (read|write), many (list result)
# and noun tokens used to pick the matching sample-data file.
TOOLS: dict[str, dict[str, Any]] = {{TOOLS_TABLE}}

_WRITES: dict[str, dict[str, Any]] = {}


def _singular(token: str) -> str:
    return token[:-1] if len(token) > 3 and token.endswith("s") and not token.endswith("ss") else token


def _records(path: pathlib.Path) -> tuple[str, list[dict]]:
    doc = json.loads(path.read_text(encoding="utf-8"))
    entity = ""
    if isinstance(doc, dict):
        entity = str((doc.get("_meta") or {}).get("entity") or "")
        rows = doc.get("records")
        if not isinstance(rows, list):
            rows = next((v for v in doc.values() if isinstance(v, list) and v and isinstance(v[0], dict)), [])
    elif isinstance(doc, list):
        rows = doc
    else:
        rows = []
    return entity, [r for r in rows if isinstance(r, dict)]


def _files_for(tool: str) -> list[tuple[str, list[dict]]]:
    """Sample-data files ranked by overlap with the tool's noun (head noun weighs double)."""
    nouns = [_singular(t) for t in TOOLS.get(tool, {}).get("nouns", [])]
    ranked = []
    for path in sorted(_DATA.glob("*.json")):
        try:
            entity, rows = _records(path)
        except (OSError, ValueError):
            continue
        tokens = {_singular(t) for t in path.stem.lower().split("_")}
        tokens |= {_singular(t) for t in entity.lower().replace("-", "_").split("_") if t}
        tokens |= {_singular(entity.lower())} if entity else set()
        score = sum((2 if i == len(nouns) - 1 else 1) for i, n in enumerate(nouns) if n in tokens)
        ranked.append((score, path.stem, rows))
    ranked.sort(key=lambda item: (-item[0], item[1]))
    return [(stem, rows) for score, stem, rows in ranked if score > 0] or [(stem, rows) for _, stem, rows in ranked]


def _field(arg: str, value: Any) -> str:
    if isinstance(value, list):
        if arg.endswith("_ids"):
            return arg[:-1]
        return _singular(arg)
    return arg


def _matches(record: dict, filters: dict[str, Any]) -> bool:
    for arg, value in filters.items():
        field = _field(arg, value)
        if isinstance(value, list):
            if record.get(field) not in value:
                return False
        elif record.get(field) != value:
            return False
    return True


def _read(tool: str, arguments: dict[str, Any]) -> Any:
    print(f"tool={tool} arguments={json.dumps(arguments, sort_keys=True)}", file=sys.stderr, flush=True)
    given = {k: v for k, v in arguments.items() if v not in (None, "", [])}
    many = TOOLS[tool]["many"]
    for _, rows in _files_for(tool):
        fields = set().union(*(r.keys() for r in rows)) if rows else set()
        filters = {k: v for k, v in given.items() if _field(k, v) in fields}
        if given and not filters:
            # Free-text arguments (e.g. `query`): substring search over record values.
            needles = [str(v).lower() for v in given.values() if isinstance(v, str)]
            hits = [r for r in rows if any(n in json.dumps(r).lower() for n in needles)]
            if not hits:
                continue
        else:
            hits = [r for r in rows if _matches(r, filters)]
        if many:
            return {"records": hits, "count": len(hits)}
        if hits:
            return hits[0]
    if many:
        return {"records": [], "count": 0}
    return {"error": "not_found", "tool": tool, "arguments": arguments}


def _write(tool: str, arguments: dict[str, Any]) -> dict[str, Any]:
    """Idempotent synthetic write: the first argument is the idempotency key."""
    print(f"tool={tool} arguments={json.dumps(arguments, sort_keys=True)}", file=sys.stderr, flush=True)
    key = str(next(iter(arguments.values()), "")) if arguments else ""
    record_id = f"{tool}-{key}" if key else tool
    if record_id not in _WRITES:
        _WRITES[record_id] = {"status": "recorded", "tool": tool, "id": record_id, "arguments": arguments}
    return _WRITES[record_id]


{{TOOL_FUNCTIONS}}

if __name__ == "__main__":
    mcp.run(transport=os.getenv("MCP_TRANSPORT") or "stdio")
