#!/usr/bin/env python3
"""Run the in-network steps of a private pilot on its in-VNet operator host.

generated by threadlight-deploy generate-only (private profile).

With public network access off, `azd provision` works from the laptop (Azure
Resource Manager is public), but the Foundry data plane (create the hosted-agent
version, invoke, evaluate) and the private registry are reachable only from
inside the VNet. This script drives the operator host created by
`infra/modules/jumpbox.bicep` through Azure Run Command, a control-plane call:
no public IP, no inbound port and no VPN on the laptop.

  python scripts/private/vnet_run.py status
  python scripts/private/vnet_run.py sync            # copy this repo and its azd environment to the host
                                                     # (files changed later on the host, such as recorded evidence, are kept)
  python scripts/private/vnet_run.py run "azd deploy --no-prompt"
  python scripts/private/vnet_run.py get specs/foundry-package-manifest.json

`run` signs in on the host with ITS managed identity (`az login --identity`,
`azd auth login --managed-identity`); it never copies a laptop token. Action Run
Command limits: one script at a time, 90 minutes, last 4,096 bytes of output
(https://learn.microsoft.com/azure/virtual-machines/linux/run-command#restrictions),
so `run` keeps the full log on the host (`.threadlight/run-*.log`) and prints its tail.
People use Azure Bastion Developer from the portal for an interactive shell.
"""
from __future__ import annotations

import argparse
import base64
import hashlib
import io
import json
import os
import re
import shlex
import subprocess
import sys
import tarfile
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
REMOTE_BASE = "/opt/threadlight"
MAX_SCRIPT_BYTES = 120_000
OUTPUT_TAIL = 3_200
EXCLUDED_DIRS = {".git", ".venv", "venv", "__pycache__", "node_modules", ".pytest_cache", ".mypy_cache",
                 ".ruff_cache", ".threadlight"}
EXIT_MARKER = "THREADLIGHT_EXIT="


def archive_names(root: Path) -> list[str]:
    """Repository files to copy (relative POSIX paths): everything but local caches and virtualenvs."""
    names = []
    for path in sorted(root.rglob("*")):
        rel = path.relative_to(root)
        if any(part in EXCLUDED_DIRS for part in rel.parts) or not path.is_file():
            continue
        names.append(rel.as_posix())
    return names


def build_archive(root: Path) -> bytes:
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
        for name in archive_names(root):
            tar.add(root / name, arcname=name, recursive=False)
    return buf.getvalue()


def upload_scripts(payload: bytes, remote_path: str) -> list[str]:
    """Shell scripts that rebuild ``payload`` at ``remote_path``, each under MAX_SCRIPT_BYTES."""
    encoded = base64.b64encode(payload).decode("ascii")
    staging = remote_path + ".b64"
    overhead = 256 + len(staging) * 2
    size = MAX_SCRIPT_BYTES - overhead
    chunks = [encoded[i:i + size] for i in range(0, len(encoded), size)] or [""]
    scripts = []
    for index, chunk in enumerate(chunks):
        lines = ["set -eu", f"mkdir -p {shlex.quote(os.path.dirname(remote_path))}"]
        if index == 0:
            lines.append(f"rm -f {shlex.quote(staging)}")
        lines.append(f"printf '%s' '{chunk}' >> {shlex.quote(staging)}")
        scripts.append("\n".join(lines) + "\n")
    digest = hashlib.sha256(payload).hexdigest()
    scripts[-1] += (f"base64 -d {shlex.quote(staging)} > {shlex.quote(remote_path)}\n"
                    f"rm -f {shlex.quote(staging)}\n"
                    f"echo '{digest}  {remote_path}' | sha256sum -c -\n")
    return scripts


def _azd_env() -> dict[str, str]:
    out = subprocess.run(["azd", "env", "get-values", "--output", "json"], cwd=ROOT,
                         capture_output=True, text=True, check=True).stdout
    return json.loads(out)


def _target(args) -> tuple[str, str, str]:
    env = _azd_env()
    rg = args.resource_group or env.get("AZURE_RESOURCE_GROUP", "")
    vm = args.vm or env.get("JUMPBOX_VM_NAME", "")
    sub = env.get("AZURE_SUBSCRIPTION_ID", "")
    if not rg or not vm:
        sys.exit("vnet_run: AZURE_RESOURCE_GROUP and JUMPBOX_VM_NAME must be in the azd env (run azd provision)")
    return sub, rg, vm


def run_script(target: tuple[str, str, str], script: str) -> tuple[int, str]:
    """One action Run Command; returns (exit code parsed from the marker, stdout+stderr tail)."""
    sub, rg, vm = target
    with tempfile.NamedTemporaryFile("w", suffix=".sh", delete=False) as handle:
        handle.write(f'(\n{script}\n)\necho "{EXIT_MARKER}$?"\n')
        path = handle.name
    try:
        cmd = ["az", "vm", "run-command", "invoke", "-g", rg, "-n", vm, "--command-id", "RunShellScript",
               "--scripts", f"@{path}", "-o", "json"]
        if sub:
            cmd += ["--subscription", sub]
        done = subprocess.run(cmd, capture_output=True, text=True)
    finally:
        os.unlink(path)
    if done.returncode != 0:
        return done.returncode, done.stderr[-OUTPUT_TAIL:]
    message = "".join(v.get("message", "") for v in json.loads(done.stdout).get("value", []))
    codes = re.findall(rf"{EXIT_MARKER}(\d+)", message)
    return (int(codes[-1]) if codes else 1), message.replace(EXIT_MARKER, "exit=")


def _remote_dir() -> str:
    return f"{REMOTE_BASE}/{ROOT.name}"


def cmd_status(target) -> int:
    code, out = run_script(target, "set -u\nexport HOME=/root\ntest -f /opt/threadlight/.cloud-init-done && echo cloud-init: done\n"
                                   "az version -o tsv --query '\"azure-cli\"' 2>&1 | head -1\nazd version 2>&1 | head -1\n"
                                   "python3 --version\n")
    print(out)
    return code


def cmd_sync(target) -> int:
    payload = build_archive(ROOT)
    remote_tar = f"{REMOTE_BASE}/{ROOT.name}.tgz"
    scripts = upload_scripts(payload, remote_tar)
    print(f"vnet_run: {len(payload)} bytes in {len(scripts)} Run Command call(s)")
    for i, script in enumerate(scripts, 1):
        code, out = run_script(target, script)
        if code != 0:
            print(out, file=sys.stderr)
            return code
        print(f"  part {i}/{len(scripts)} ok")
    dest = _remote_dir()
    code, out = run_script(target, f"set -eu\nmkdir -p {dest}\n"
                                   # Keep files the host changed later (evidence recorded in the VNet).
                                   f"tar --keep-newer-files --warning=no-ignore-newer -xzf {remote_tar} -C {dest}\n"
                                   f"find {dest} -name '*.sh' -exec chmod +x {{}} +\necho synced to {dest}\n")
    print(out)
    return code


def cmd_run(target, command: str) -> int:
    stamp = time.strftime("%Y%m%d-%H%M%S")
    log = f".threadlight/run-{stamp}.log"
    script = f"""set -u
export HOME=/root AZD_SKIP_UPDATE_CHECK=true PATH=/usr/local/bin:/usr/bin:/bin:$PATH
cd {_remote_dir()} || exit 3
mkdir -p .threadlight
{{
  az login --identity --output none &&
  azd auth login --managed-identity >/dev/null &&
  (azd extension show azure.ai.agents >/dev/null 2>&1 || azd extension install azure.ai.agents >/dev/null) &&
  echo "+ {command.replace('"', "'")}" &&
  {command}
}} > {log} 2>&1
rc=$?
echo "log: {_remote_dir()}/{log}"
tail -c {OUTPUT_TAIL} {log}
exit $rc
"""
    code, out = run_script(target, script)
    print(out)
    return code


def cmd_get(target, remote_rel: str, local: Path) -> int:
    remote = f"{_remote_dir()}/{remote_rel}"
    code, out = run_script(target, f"set -eu\nstat -c %s {shlex.quote(remote)}\n")
    sizes = re.findall(r"^(\d+)$", out, re.M)
    if code != 0 or not sizes:
        print(out, file=sys.stderr)
        return code or 1
    size, step, data = int(sizes[0]), 2_000, b""
    for offset in range(0, size, step):
        code, out = run_script(target, f"set -eu\necho BEGIN; dd if={shlex.quote(remote)} bs=1 skip={offset} "
                                       f"count={step} status=none | base64 -w0; echo; echo END\n")
        part = re.search(r"BEGIN\n(.*?)\nEND", out, re.S)
        if code != 0 or not part:
            print(out, file=sys.stderr)
            return code or 1
        data += base64.b64decode(part.group(1).strip())
    local.parent.mkdir(parents=True, exist_ok=True)
    local.write_bytes(data)
    print(f"vnet_run: {remote} -> {local} ({len(data)} bytes)")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--resource-group")
    parser.add_argument("--vm")
    sub = parser.add_subparsers(dest="action", required=True)
    sub.add_parser("status")
    sub.add_parser("sync")
    run = sub.add_parser("run")
    run.add_argument("command")
    get = sub.add_parser("get")
    get.add_argument("path")
    get.add_argument("--to", type=Path)
    args = parser.parse_args(argv)
    target = _target(args)
    if args.action == "status":
        return cmd_status(target)
    if args.action == "sync":
        return cmd_sync(target)
    if args.action == "run":
        return cmd_run(target, args.command)
    return cmd_get(target, args.path, args.to or ROOT / args.path)


if __name__ == "__main__":
    sys.exit(main())
