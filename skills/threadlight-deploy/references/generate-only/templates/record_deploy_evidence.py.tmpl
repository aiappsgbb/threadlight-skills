#!/usr/bin/env python3
"""Record deploy evidence in specs/foundry-package-manifest.json (generated by threadlight-deploy generate-only).

Run after ``azd up`` and at least one ``azd ai agent invoke``::

    python scripts/record_deploy_evidence.py [--trace-id <id>] [--dry-run]

It reads, and never invents:

* ``agent.agent_id`` / ``agent.agent_version`` from ``azd ai agent show <agent> -o json``
  (``agent_guid``, else ``id``; ``version``);
* ``telemetry.app_insights_connection_id`` from the azd output
  ``AZURE_AI_APPINSIGHTS_CONNECTION_ID`` (the project's App Insights connection
  created by ``infra/main.bicep``);
* ``telemetry.trace_id`` from ``--trace-id`` (the ``Trace ID`` printed by
  ``azd ai agent invoke``), else the latest ``invoke_agent`` request for this
  agent in the connected App Insights (``az monitor app-insights query``, last 24 h).

A value that cannot be read stays null and the script exits 3, so
``skills/_shared/foundry_package.py`` keeps reporting INCOMPLETE. The eval run
id and rubric score are recorded by ``evals/run_evals.py``.
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "specs" / "foundry-package-manifest.json"
TRACE = re.compile(r"^[0-9a-f]{32}$")


def run(cmd: list[str]) -> str:
    """Run a CLI command and return stdout ('' on failure). Tests replace this."""
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.SubprocessError):
        return ""
    return out.stdout if out.returncode == 0 else ""


def _json(text: str):
    try:
        return json.loads(text) if text.strip() else None
    except ValueError:
        return None


def latest_trace(app_insights_id: str, agent: str) -> str | None:
    query = (
        "requests | where name == 'invoke_agent'"
        f" | where tostring(customDimensions['gen_ai.agent.name']) == '{agent}'"
        " | top 1 by timestamp desc | project operation_Id"
    )
    result = _json(run(["az", "monitor", "app-insights", "query", "--apps", app_insights_id,
                        "--offset", "24h", "--analytics-query", query, "-o", "json"]))
    try:
        value = result["tables"][0]["rows"][0][0]
    except (TypeError, KeyError, IndexError):
        return None
    return value if isinstance(value, str) and TRACE.match(value) else None


def collect(agent: str, trace_id: str | None) -> dict[str, str | None]:
    env = _json(run(["azd", "env", "get-values", "--output", "json"])) or {}
    show = _json(run(["azd", "ai", "agent", "show", agent, "-o", "json"])) or {}
    found: dict[str, str | None] = {
        "agent_id": str(show.get("agent_guid") or show.get("id") or "") or None,
        "agent_version": str(show.get("version") or "") or None,
        "app_insights_connection_id": env.get("AZURE_AI_APPINSIGHTS_CONNECTION_ID") or None,
        "trace_id": None,
    }
    if trace_id:
        found["trace_id"] = trace_id
    elif env.get("APPLICATIONINSIGHTS_RESOURCE_ID"):
        found["trace_id"] = latest_trace(env["APPLICATIONINSIGHTS_RESOURCE_ID"], agent)
    return found


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Record deploy evidence in specs/foundry-package-manifest.json.")
    parser.add_argument("--trace-id", help="trace id printed by `azd ai agent invoke` (32 hex characters)")
    parser.add_argument("--dry-run", action="store_true", help="print what would be recorded, write nothing")
    args = parser.parse_args(argv)
    if args.trace_id and not TRACE.match(args.trace_id):
        parser.error("--trace-id must be 32 lowercase hex characters")

    manifest = json.loads(MANIFEST.read_text(encoding="utf-8"))
    agent = manifest["agent"]["agent_name"]
    found = collect(agent, args.trace_id)
    missing = sorted(k for k, v in found.items() if not v)
    print(json.dumps({"agent": agent, "recorded": {k: v for k, v in found.items() if v}, "missing": missing}))
    if args.dry_run:
        return 3 if missing else 0
    for key in ("agent_id", "agent_version"):
        if found[key]:
            manifest["agent"][key] = found[key]
    for key in ("app_insights_connection_id", "trace_id"):
        if found[key]:
            manifest["telemetry"][key] = found[key]
    MANIFEST.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    return 3 if missing else 0


if __name__ == "__main__":
    sys.exit(main())
