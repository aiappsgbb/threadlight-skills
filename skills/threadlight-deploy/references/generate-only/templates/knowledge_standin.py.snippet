# --- Knowledge stand-in (generated by threadlight-deploy generate-only) -------
# SPEC section 6 backs these tools with a knowledge base (Foundry IQ / AI Search)
# that generate-only does NOT provision. Until threadlight-ground creates it,
# they answer read-only from the packaged specs/knowledge/*.md so the agent can
# still cite real clauses. Replace the tool binding when the knowledge base exists.
_KNOWLEDGE = pathlib.Path(
    os.getenv("KNOWLEDGE_DIR")
    or next(
        (str(p) for p in (_HERE.parent.parent / "specs" / "knowledge", _HERE / "knowledge") if p.is_dir()),
        str(_HERE / "knowledge"),
    )
)
_CLAUSE = re.compile(r"\b([A-Z]{1,6}-\d+(?:\.\d+)*)\b")
_STANDIN = "local stand-in: specs/knowledge (knowledge base not provisioned by generate-only)"


def _sections() -> list[dict[str, str]]:
    """Paragraphs of every ``*.md``; a paragraph opening with a clause id is its own unit."""
    found = []
    for path in sorted(_KNOWLEDGE.glob("*.md")):
        title = path.stem
        for block in re.split(r"\n\s*\n", path.read_text(encoding="utf-8")):
            block = block.strip()
            if not block:
                continue
            if block.startswith("#"):
                heading, _, block = block.partition("\n")
                title = heading.lstrip("#").strip()
                block = block.strip()
                if not block:
                    continue
            own = _CLAUSE.match(block.lstrip("*_> "))
            heading_clause = _CLAUSE.search(title)
            clause = own.group(1) if own else (heading_clause.group(1) if heading_clause else title)
            found.append({"clause_id": clause, "title": title, "text": block[:1200], "source": path.name})
    return found


def _knowledge(tool: str, arguments: dict[str, Any]) -> dict[str, Any]:
    print(f"tool={tool} arguments={json.dumps(arguments, sort_keys=True)}", file=sys.stderr, flush=True)
    query = " ".join(str(v) for v in arguments.values() if isinstance(v, (str, list)) and v)
    wanted = set(_CLAUSE.findall(query))
    words = {w for w in re.findall(r"[a-z0-9]{3,}", query.lower())}
    scored = []
    for section in _sections():
        haystack = f"{section['title']} {section['text']}".lower()
        score = (10 if section["clause_id"] in wanted else 0) + sum(1 for w in words if w in haystack)
        if score:
            scored.append((score, section))
    scored.sort(key=lambda item: -item[0])
    hits = [s for _, s in scored[:3]]
    if not hits:
        return {"answer": "", "citations": [], "backing": _STANDIN,
                "message": "no matching clause; do not invent one"}
    return {"answer": hits[0]["text"], "backing": _STANDIN,
            "citations": [{"clause_id": h["clause_id"], "text": h["text"], "source": h["source"]} for h in hits]}
