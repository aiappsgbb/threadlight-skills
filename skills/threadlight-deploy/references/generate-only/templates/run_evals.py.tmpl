#!/usr/bin/env python3
"""Run the SPEC-derived Foundry evaluation against the deployed hosted agent.

Generated by threadlight-deploy generate-only. One command after ``azd up``::

    python -m pip install --require-hashes -r evals/requirements.lock
    python evals/run_evals.py

Reads ``evals/eval-config.json`` and ``evals/eval_dataset.jsonl``, creates a
Foundry eval with built-in evaluators plus the SPEC rubric (``score_model``),
runs it against the deployed agent (``azure_ai_target_completions`` data source,
``azure_ai_agent`` target), waits for the result and records the run id, the
rubric score and per-evaluator scored/errored row counts in
``specs/foundry-package-manifest.json``. An evaluator error is a missing score,
never a pass. The request body comes from ``eval-config.json``
``input_messages``: the Invocations body for a hosted GHCP agent, the Responses
``template`` input for a prompt or Copilot harness agent.

Environment (``azd env get-values`` provides them after deploy):
  FOUNDRY_PROJECT_ENDPOINT or AZURE_AI_PROJECT_ENDPOINT
  AZURE_AI_FIXED_MODEL_DEPLOYMENT_NAME  judge model for the evaluators (a fixed
                                       model; the agent itself may use a router)
  AZURE_AI_MODEL_DEPLOYMENT_NAME   judge fallback when no fixed deployment is set

``--dry-run`` prints the eval request as JSON without SDKs, login or network.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
CONFIG = ROOT / "evals" / "eval-config.json"
MANIFEST = ROOT / "specs" / "foundry-package-manifest.json"
TERMINAL = {"completed", "failed", "canceled", "cancelled"}


def load_config() -> dict:
    return json.loads(CONFIG.read_text(encoding="utf-8"))


def load_rows(cfg: dict) -> list[dict]:
    path = ROOT / cfg.get("dataset", "evals/eval_dataset.jsonl")
    rows = [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
    for row in rows:
        # threadlight-design writes `prompt`; the eval template reads `query`.
        if not row.get("query"):
            row["query"] = row.get("prompt") or row.get("input") or ""
    return rows


def data_source(cfg: dict, rows: list[dict]) -> dict:
    target = dict(cfg["target"])
    target.setdefault("version", os.getenv("AGENT_VERSION", "1"))
    return {
        "type": "azure_ai_target_completions",
        "source": {"type": "file_content", "content": [{"item": row} for row in rows]},
        # From eval-config.json. Invocations-protocol hosted agent: the freeform template is
        # the /invocations body; "stream": false returns only the final answer text (the SSE
        # stream is 200-300 KB per case: judge 429s and a 413 on result upload);
        # "new_conversation": true keeps rows from sharing one conversation. Prompt and
        # Copilot harness agents take the Responses {"type": "template"} input instead.
        "input_messages": cfg.get("input_messages",
                                  {"input": "{{item.query}}", "stream": False, "new_conversation": True}),
        "target": target,
    }


def testing_criteria(cfg: dict, deployment: str) -> list[dict]:
    criteria = [
        {
            "type": "azure_ai_evaluator",
            "name": ev.get("name", ev["evaluator_name"].split(".", 1)[-1]),
            "evaluator_name": ev["evaluator_name"],
            "initialization_parameters": {"deployment_name": deployment},
            "data_mapping": ev.get(
                "data_mapping", {"query": "{{item.query}}", "response": "{{sample.output_text}}"}
            ),
        }
        for ev in cfg["builtin_evaluators"]
    ]
    for rubric in cfg["custom_rubric_evaluators"]:
        criteria.append(
            {
                "type": "score_model",
                "name": rubric["name"],
                "model": deployment,
                "input": [
                    {"role": "system", "content": rubric["system_prompt"]},
                    {"role": "user", "content": rubric["user_prompt"]},
                ],
                "range": rubric.get("range", [1, 5]),
                "pass_threshold": rubric["threshold"],
            }
        )
    return criteria


def item_schema(rows: list[dict]) -> dict:
    keys = sorted({k for row in rows for k in row})
    props = {k: ({"type": "array", "items": {"type": "string"}} if k == "business_rules" else {"type": "string"}) for k in keys}
    return {"type": "object", "properties": props, "required": ["query"]}


def _env(*names: str) -> str:
    for name in names:
        if os.getenv(name):
            return os.environ[name]
    try:
        out = subprocess.run(["azd", "env", "get-values", "--output", "json"], capture_output=True, text=True, timeout=60)
        values = json.loads(out.stdout or "{}") if out.returncode == 0 else {}
    except (OSError, ValueError, subprocess.SubprocessError):
        values = {}
    for name in names:
        if values.get(name):
            return values[name]
    raise SystemExit(f"run_evals: set {' or '.join(names)} (or run inside the azd environment)")


def _get(obj, key, default=None):
    return obj.get(key, default) if isinstance(obj, dict) else getattr(obj, key, default)


def _transient(exc: Exception) -> bool:
    # openai.APIConnectionError / APITimeoutError wrap DNS and reset errors.
    name = type(exc).__name__
    return isinstance(exc, (ConnectionError, TimeoutError, OSError)) or "Connection" in name or "Timeout" in name


def poll_run(client, run, eval_id: str, *, sleep=time.sleep, interval: float = 10, max_failures: int = 6):
    """Wait for a terminal run status; a transient network error (DNS, reset) is retried.

    The run keeps going server-side, so a lost poll must not end the script.
    ``max_failures`` consecutive errors re-raise the last one.
    """
    failures = 0
    while _get(run, "status") not in TERMINAL:
        sleep(min(interval * 2 ** failures, 120))
        try:
            run = client.evals.runs.retrieve(run_id=run.id, eval_id=eval_id)
            failures = 0
        except Exception as exc:  # noqa: BLE001 - only transient network errors are retried
            failures += 1
            if not _transient(exc) or failures >= max_failures:
                raise
            print(json.dumps({"poll_retry": failures, "error": type(exc).__name__}), file=sys.stderr)
    return run


def _errored(result) -> bool:
    sample = _get(result, "sample") or {}
    status = str(_get(result, "status") or "").lower()
    return (bool(_get(result, "error")) or bool(_get(sample, "error")) or status in ("error", "errored", "failed")
            or not isinstance(_get(result, "score"), (int, float)) or isinstance(_get(result, "score"), bool))


def summarize(items) -> dict:
    """Per evaluator: scored rows, errored rows and the scores. An error is never a score."""
    summary: dict = {}
    for item in items:
        for result in _get(item, "results", []) or []:
            entry = summary.setdefault(_get(result, "name"), {"scored": 0, "errored": 0, "scores": []})
            if _errored(result):
                entry["errored"] += 1
            else:
                entry["scored"] += 1
                entry["scores"].append(_get(result, "score"))
    return summary


def record(run_id: str, rubric_name: str, score, summary: dict | None = None) -> None:
    manifest = json.loads(MANIFEST.read_text(encoding="utf-8"))
    evaluation = manifest.setdefault("evaluation", {})
    evaluation["eval_run_id"] = run_id
    if summary is not None:
        evaluation["evaluator_results"] = {name: {"scored": v["scored"], "errored": v["errored"]}
                                           for name, v in sorted(summary.items())}
    for rubric in evaluation.get("custom_rubric_evaluators", []):
        if rubric.get("name") == rubric_name and score is not None:
            rubric["score"] = score
    MANIFEST.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")


def main(argv: list[str] | None = None) -> int:
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    parser = argparse.ArgumentParser(description="Run the SPEC-derived Foundry eval against the hosted agent.")
    parser.add_argument("--dry-run", action="store_true", help="print the eval request offline and exit")
    parser.add_argument("--no-wait", action="store_true", help="create the run and exit without polling")
    args = parser.parse_args(argv)

    cfg = load_config()
    rows = load_rows(cfg)
    if args.dry_run:
        deployment = (os.getenv("AZURE_AI_FIXED_MODEL_DEPLOYMENT_NAME")
                      or os.getenv("AZURE_AI_MODEL_DEPLOYMENT_NAME", "<AZURE_AI_MODEL_DEPLOYMENT_NAME>"))
        print(json.dumps({"data_source": data_source(cfg, rows), "testing_criteria": testing_criteria(cfg, deployment)}, indent=2))
        return 0

    endpoint = _env("FOUNDRY_PROJECT_ENDPOINT", "AZURE_AI_PROJECT_ENDPOINT")
    # A model router judge would pick a different model per row; judge with the fixed model.
    deployment = _env("AZURE_AI_FIXED_MODEL_DEPLOYMENT_NAME", "AZURE_AI_MODEL_DEPLOYMENT_NAME")
    from azure.ai.projects import AIProjectClient  # lazy: --dry-run needs no SDK
    from azure.identity import DefaultAzureCredential

    client = AIProjectClient(endpoint=endpoint, credential=DefaultAzureCredential()).get_openai_client()
    ev = client.evals.create(
        name=f"{cfg['target']['name']}-spec-eval",
        data_source_config={"type": "custom", "item_schema": item_schema(rows), "include_sample_schema": True},
        testing_criteria=testing_criteria(cfg, deployment),
    )
    run = client.evals.runs.create(eval_id=ev.id, name=f"{cfg['target']['name']}-run", data_source=data_source(cfg, rows))
    print(json.dumps({"eval_id": ev.id, "run_id": run.id, "status": _get(run, "status")}))
    if args.no_wait:
        record(run.id, cfg["custom_rubric_evaluators"][0]["name"], None)
        return 0
    run = poll_run(client, run, ev.id)
    rubric_name = cfg["custom_rubric_evaluators"][0]["name"]
    summary = summarize(client.evals.runs.output_items.list(run_id=run.id, eval_id=ev.id))
    rubric = summary.get(rubric_name) or {"scored": 0, "errored": 0, "scores": []}
    # Any errored rubric row leaves the score unset: the package gate treats it as missing.
    score = (round(sum(rubric["scores"]) / len(rubric["scores"]), 3)
             if rubric["scores"] and not rubric["errored"] else None)
    record(run.id, rubric_name, score, summary)
    print(json.dumps({"run_id": run.id, "status": _get(run, "status"), "rubric": rubric_name, "mean_score": score,
                      "threshold": cfg["custom_rubric_evaluators"][0]["threshold"],
                      "evaluators": {k: {"scored": v["scored"], "errored": v["errored"]} for k, v in summary.items()},
                      "report_url": _get(run, "report_url")}))
    return 0 if _get(run, "status") == "completed" else 1


if __name__ == "__main__":
    sys.exit(main())
