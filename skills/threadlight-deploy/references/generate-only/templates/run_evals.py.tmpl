#!/usr/bin/env python3
"""Run the SPEC-derived Foundry evaluation against the deployed hosted agent.

Generated by threadlight-deploy generate-only. One command after ``azd up``::

    python -m pip install --require-hashes -r evals/requirements.lock
    python evals/run_evals.py

Reads ``evals/eval-config.json`` and ``evals/eval_dataset.jsonl``, creates a
Foundry eval with built-in evaluators plus the SPEC rubric (``score_model``),
runs it against the hosted agent (``azure_ai_target_completions`` data source,
``azure_ai_agent`` target), waits for the result and records the run id and
rubric score in ``specs/foundry-package-manifest.json``.

Environment (``azd env get-values`` provides them after deploy):
  FOUNDRY_PROJECT_ENDPOINT or AZURE_AI_PROJECT_ENDPOINT
  AZURE_AI_MODEL_DEPLOYMENT_NAME   judge model for the evaluators

``--dry-run`` prints the eval request as JSON without SDKs, login or network.
"""
from __future__ import annotations

import argparse
import io
import json
import os
import subprocess
import sys
import time
from pathlib import Path

if hasattr(sys.stdout, "buffer"):
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")

ROOT = Path(__file__).resolve().parents[1]
CONFIG = ROOT / "evals" / "eval-config.json"
MANIFEST = ROOT / "specs" / "foundry-package-manifest.json"
TERMINAL = {"completed", "failed", "canceled", "cancelled"}


def load_config() -> dict:
    return json.loads(CONFIG.read_text(encoding="utf-8"))


def load_rows(cfg: dict) -> list[dict]:
    path = ROOT / cfg.get("dataset", "evals/eval_dataset.jsonl")
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def data_source(cfg: dict, rows: list[dict]) -> dict:
    target = dict(cfg["target"])
    target.setdefault("version", os.getenv("AGENT_VERSION", "1"))
    return {
        "type": "azure_ai_target_completions",
        "source": {"type": "file_content", "content": [{"item": row} for row in rows]},
        # Invocations-protocol hosted agent: the freeform template is the /invocations body.
        "input_messages": cfg.get("input_messages", {"input": "{{item.query}}"}),
        "target": target,
    }


def testing_criteria(cfg: dict, deployment: str) -> list[dict]:
    criteria = [
        {
            "type": "azure_ai_evaluator",
            "name": ev.get("name", ev["evaluator_name"].split(".", 1)[-1]),
            "evaluator_name": ev["evaluator_name"],
            "initialization_parameters": {"deployment_name": deployment},
            "data_mapping": ev.get(
                "data_mapping", {"query": "{{item.query}}", "response": "{{sample.output_text}}"}
            ),
        }
        for ev in cfg["builtin_evaluators"]
    ]
    for rubric in cfg["custom_rubric_evaluators"]:
        criteria.append(
            {
                "type": "score_model",
                "name": rubric["name"],
                "model": deployment,
                "input": [
                    {"role": "system", "content": rubric["system_prompt"]},
                    {"role": "user", "content": rubric["user_prompt"]},
                ],
                "range": rubric.get("range", [1, 5]),
                "pass_threshold": rubric["threshold"],
            }
        )
    return criteria


def item_schema(rows: list[dict]) -> dict:
    keys = sorted({k for row in rows for k in row})
    props = {k: ({"type": "array", "items": {"type": "string"}} if k == "business_rules" else {"type": "string"}) for k in keys}
    return {"type": "object", "properties": props, "required": ["query"]}


def _env(*names: str) -> str:
    for name in names:
        if os.getenv(name):
            return os.environ[name]
    try:
        out = subprocess.run(["azd", "env", "get-values", "--output", "json"], capture_output=True, text=True, timeout=60)
        values = json.loads(out.stdout or "{}") if out.returncode == 0 else {}
    except (OSError, ValueError, subprocess.SubprocessError):
        values = {}
    for name in names:
        if values.get(name):
            return values[name]
    raise SystemExit(f"run_evals: set {' or '.join(names)} (or run inside the azd environment)")


def _get(obj, key, default=None):
    return obj.get(key, default) if isinstance(obj, dict) else getattr(obj, key, default)


def record(run_id: str, rubric_name: str, score) -> None:
    manifest = json.loads(MANIFEST.read_text(encoding="utf-8"))
    evaluation = manifest.setdefault("evaluation", {})
    evaluation["eval_run_id"] = run_id
    for rubric in evaluation.get("custom_rubric_evaluators", []):
        if rubric.get("name") == rubric_name and score is not None:
            rubric["score"] = score
    MANIFEST.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Run the SPEC-derived Foundry eval against the hosted agent.")
    parser.add_argument("--dry-run", action="store_true", help="print the eval request offline and exit")
    parser.add_argument("--no-wait", action="store_true", help="create the run and exit without polling")
    args = parser.parse_args(argv)

    cfg = load_config()
    rows = load_rows(cfg)
    if args.dry_run:
        deployment = os.getenv("AZURE_AI_MODEL_DEPLOYMENT_NAME", "<AZURE_AI_MODEL_DEPLOYMENT_NAME>")
        print(json.dumps({"data_source": data_source(cfg, rows), "testing_criteria": testing_criteria(cfg, deployment)}, indent=2))
        return 0

    endpoint = _env("FOUNDRY_PROJECT_ENDPOINT", "AZURE_AI_PROJECT_ENDPOINT")
    deployment = _env("AZURE_AI_MODEL_DEPLOYMENT_NAME")
    from azure.ai.projects import AIProjectClient  # lazy: --dry-run needs no SDK
    from azure.identity import DefaultAzureCredential

    client = AIProjectClient(endpoint=endpoint, credential=DefaultAzureCredential()).get_openai_client()
    ev = client.evals.create(
        name=f"{cfg['target']['name']}-spec-eval",
        data_source_config={"type": "custom", "item_schema": item_schema(rows), "include_sample_schema": True},
        testing_criteria=testing_criteria(cfg, deployment),
    )
    run = client.evals.runs.create(eval_id=ev.id, name=f"{cfg['target']['name']}-run", data_source=data_source(cfg, rows))
    print(json.dumps({"eval_id": ev.id, "run_id": run.id, "status": _get(run, "status")}))
    if args.no_wait:
        record(run.id, cfg["custom_rubric_evaluators"][0]["name"], None)
        return 0
    while _get(run, "status") not in TERMINAL:
        time.sleep(10)
        run = client.evals.runs.retrieve(run_id=run.id, eval_id=ev.id)
    rubric_name = cfg["custom_rubric_evaluators"][0]["name"]
    scores = []
    for item in client.evals.runs.output_items.list(run_id=run.id, eval_id=ev.id):
        for result in _get(item, "results", []) or []:
            if _get(result, "name") == rubric_name and isinstance(_get(result, "score"), (int, float)):
                scores.append(_get(result, "score"))
    score = round(sum(scores) / len(scores), 3) if scores else None
    record(run.id, rubric_name, score)
    print(json.dumps({"run_id": run.id, "status": _get(run, "status"), "rubric": rubric_name, "mean_score": score,
                      "threshold": cfg["custom_rubric_evaluators"][0]["threshold"], "report_url": _get(run, "report_url")}))
    return 0 if _get(run, "status") == "completed" else 1


if __name__ == "__main__":
    sys.exit(main())
