# Generated by threadlight-cicd v{{GENERATOR_VERSION}} on {{ISO_TIMESTAMP}}.
# Validation and production use distinct RG-scoped WIF service connections.
# Configure environment approvals/checks separately; this YAML cannot create them.
# Never deploy or modify the central Citadel hub from either target.
trigger:
  branches:
    include: [ main ]

pool:
  {{ADO_POOL_SPEC}}

stages:
  - stage: validation
    displayName: Deploy and verify the preproduction candidate
    condition: and(succeeded(), eq(variables['Build.SourceBranch'], 'refs/heads/main'), ne(variables['Build.Reason'], 'PullRequest'), ne(variables['Build.Reason'], 'Schedule'))
    jobs:
      - deployment: validate_candidate
        environment: {{VALIDATION_ENV_NAME}}
        strategy:
          runOnce:
            deploy:
              steps:
                - checkout: self
                - task: UsePythonVersion@0
                  inputs:
                    versionSpec: '3.12'
                - bash: python3 .threadlight/skills/threadlight-cicd/scripts/release_runner.py preflight --policy {{RELEASE_POLICY}}
                  displayName: Check policy and source before authentication or deployment
                - task: AzureCLI@2
                  name: validate
                  displayName: Prepare candidate and execute strict evidence producers
                  env:
                    THREADLIGHT_RELEASE_ENVIRONMENT: {{VALIDATION_ENV_NAME}}
                    AZURE_TOKEN_CREDENTIALS: AzureCliCredential
                    AZD_CONFIG_DIR: $(Agent.TempDirectory)/threadlight-azd-validation-$(Build.BuildId)
                  inputs:
                    azureSubscription: {{VALIDATION_SERVICE_CONNECTION}}
                    scriptType: bash
                    scriptLocation: inlineScript
                    visibleAzLogin: false
                    inlineScript: |
                      set -euo pipefail
                      python3 .threadlight/skills/threadlight-cicd/scripts/release_runner.py validate --policy {{RELEASE_POLICY}}
                - task: PublishPipelineArtifact@1
                  displayName: Publish metadata-only candidate receipt
                  inputs:
                    targetPath: $(Build.SourcesDirectory)/.threadlight-release/candidate.json
                    artifact: threadlight-candidate-$(Build.BuildId)

  - stage: promotion
    displayName: Approved production promotion
    dependsOn: validation
    condition: and(succeeded(), eq(variables['Build.SourceBranch'], 'refs/heads/main'), ne(variables['Build.Reason'], 'PullRequest'), ne(variables['Build.Reason'], 'Schedule'))
    variables:
      receiptSha256: $[stageDependencies.validation.validate_candidate.outputs['validate_candidate.validate.receiptSha256']]
    jobs:
      - deployment: promote_candidate
        environment: {{ENV_NAME}}
        strategy:
          runOnce:
            deploy:
              steps:
                - checkout: self
                - task: UsePythonVersion@0
                  inputs:
                    versionSpec: '3.12'
                - bash: python3 .threadlight/skills/threadlight-cicd/scripts/release_runner.py preflight --policy {{RELEASE_POLICY}}
                  displayName: Check current source and policy
                - download: current
                  artifact: threadlight-candidate-$(Build.BuildId)
                - bash: |
                    set -euo pipefail
                    mkdir -p .threadlight-release
                    cp "$(Pipeline.Workspace)/threadlight-candidate-$(Build.BuildId)/candidate.json" .threadlight-release/candidate.json
                  displayName: Stage the current run's candidate receipt
                - task: AzureCLI@2
                  displayName: Promote and independently observe the exact production image
                  env:
                    THREADLIGHT_RELEASE_ENVIRONMENT: {{ENV_NAME}}
                    RELEASE_RECEIPT_SHA256: $(receiptSha256)
                    AZURE_TOKEN_CREDENTIALS: AzureCliCredential
                    AZD_CONFIG_DIR: $(Agent.TempDirectory)/threadlight-azd-production-$(Build.BuildId)
                  inputs:
                    azureSubscription: {{ADO_SERVICE_CONNECTION}}
                    scriptType: bash
                    scriptLocation: inlineScript
                    visibleAzLogin: false
                    inlineScript: |
                      set -euo pipefail
                      python3 .threadlight/skills/threadlight-cicd/scripts/release_runner.py promote --policy {{RELEASE_POLICY}} --receipt-sha256 "$RELEASE_RECEIPT_SHA256"
