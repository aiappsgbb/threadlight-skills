# Generated by threadlight-cicd v{{GENERATOR_VERSION}} on {{ISO_TIMESTAMP}}.
# Separate validation and production targets; never deploy the central hub.
# Pre-existing environment approval/branch checks are platform prerequisites,
# not created by this YAML. See docs/threadlight-cicd/release-contract.md.
name: verified-agent-release

on:
  workflow_dispatch: {}
  push:
    branches: [ main ]
    paths-ignore: [ '**.md', 'docs/**' ]

permissions:
  id-token: write
  contents: read

jobs:
  validation:
    if: github.ref == 'refs/heads/main' && github.event_name != 'pull_request' && github.event_name != 'schedule'
    runs-on: {{RUNNER_RUNS_ON}}
    environment: {{VALIDATION_ENV_NAME}}
    outputs:
      receipt_sha256: ${{ steps.validate.outputs.receipt_sha256 }}
    env:
      THREADLIGHT_RELEASE_ENVIRONMENT: {{VALIDATION_ENV_NAME}}
      AZURE_CLIENT_ID: {{VALIDATION_CLIENT_ID}}
      AZURE_TENANT_ID: {{VALIDATION_TENANT_ID}}
      AZURE_SUBSCRIPTION_ID: {{VALIDATION_SUBSCRIPTION_ID}}
      AZURE_TOKEN_CREDENTIALS: AzureCliCredential
      AZURE_CONFIG_DIR: ${{ runner.temp }}/threadlight-azure-validation-${{ github.run_id }}-${{ github.run_attempt }}
      AZD_CONFIG_DIR: ${{ runner.temp }}/threadlight-azd-validation-${{ github.run_id }}-${{ github.run_attempt }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Check reviewed policy and source before authentication or deployment
        run: python3 .threadlight/skills/threadlight-cicd/scripts/release_runner.py preflight --policy {{RELEASE_POLICY}}
      - uses: Azure/setup-azd@v2
      - name: Validation identity (OIDC, validation RG only)
        uses: azure/login@v2
        with:
          client-id: {{VALIDATION_CLIENT_ID}}
          tenant-id: {{VALIDATION_TENANT_ID}}
          subscription-id: {{VALIDATION_SUBSCRIPTION_ID}}
      - name: Deploy candidate, execute producers, enforce all required domains
        id: validate
        run: python3 .threadlight/skills/threadlight-cicd/scripts/release_runner.py validate --policy {{RELEASE_POLICY}}
      - name: Publish metadata-only candidate receipt
        uses: actions/upload-artifact@v4
        with:
          name: threadlight-candidate-${{ github.run_id }}-${{ github.run_attempt }}
          path: .threadlight-release/candidate.json
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 1

  promotion:
    needs: validation
    if: github.ref == 'refs/heads/main' && github.event_name != 'pull_request' && github.event_name != 'schedule'
    runs-on: {{RUNNER_RUNS_ON}}
    environment: {{ENV_NAME}}
    env:
      THREADLIGHT_RELEASE_ENVIRONMENT: {{ENV_NAME}}
      RELEASE_RECEIPT_SHA256: ${{ needs.validation.outputs.receipt_sha256 }}
      AZURE_CLIENT_ID: {{AZURE_CLIENT_ID}}
      AZURE_TENANT_ID: {{TENANT_ID}}
      AZURE_SUBSCRIPTION_ID: {{TARGET_SUBSCRIPTION_ID}}
      AZURE_TOKEN_CREDENTIALS: AzureCliCredential
      AZURE_CONFIG_DIR: ${{ runner.temp }}/threadlight-azure-production-${{ github.run_id }}-${{ github.run_attempt }}
      AZD_CONFIG_DIR: ${{ runner.temp }}/threadlight-azd-production-${{ github.run_id }}-${{ github.run_attempt }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Check current source and policy
        run: python3 .threadlight/skills/threadlight-cicd/scripts/release_runner.py preflight --policy {{RELEASE_POLICY}}
      - uses: actions/download-artifact@v4
        with:
          name: threadlight-candidate-${{ github.run_id }}-${{ github.run_attempt }}
          path: .threadlight-release
      - uses: Azure/setup-azd@v2
      - name: Production identity (OIDC, production RG only)
        uses: azure/login@v2
        with:
          client-id: {{AZURE_CLIENT_ID}}
          tenant-id: {{TENANT_ID}}
          subscription-id: {{TARGET_SUBSCRIPTION_ID}}
      - name: Promote the verified candidate and independently observe production
        run: >
          python3 .threadlight/skills/threadlight-cicd/scripts/release_runner.py
          promote --policy {{RELEASE_POLICY}} --receipt-sha256 "$RELEASE_RECEIPT_SHA256"
